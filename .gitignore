/target/
**/*.rs.bk
.idea/
.vscode/
*.swp
.DS_Store
.oride/
.daisy/
.mimocode/
# Prumo: estado derivado e de execução.
.prumo/runtime/
.prumo/cache/

# `.ai/skills/` é versionado de propósito. As skills do catálogo são
# reproduzíveis pelo `prumo.lock`, mas as skills **locais** (as que o catálogo
# não cobre) existem só aqui — e ignorar o diretório inteiro as esconderia em
# silêncio. O custo é diff maior quando o workforce muda; a alternativa custa
# perder conteúdo autoral sem aviso.

# Go: o binário escrito por `go build ./cmd/oride` na raiz.
/oride
/oride.exe
*.test
coverage.out

# Estado local do agente (taste/sessão), não é conteúdo do projeto
.commandcode/

# TypeScript/Bun migration
/node_modules/
/dist/
/daisy-bin
/release-dist/

# Demos VHS: GIFs nunca entram; só o config pinado dos fixtures é tracked
# (a session.toml que o app escreve ao sair é lixo de gravação).
demos/out/
demos/*/.daisy/session.toml
!demos/fixture-agents/.daisy/
!demos/fixture-agents/.daisy/config.toml
!demos/fixture-scm/.daisy/
!demos/fixture-scm/.daisy/config.toml
